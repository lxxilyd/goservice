#!/bin/sh
#
# my-daemon - installed by goservice
#
# chkconfig: 2345 95 05
# description: Example daemon for the renderer tests
#
### BEGIN INIT INFO
# Provides:          my-daemon
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: my-daemon
# Description:       Example daemon for the renderer tests
### END INIT INFO

name='my-daemon'
pid_file="/var/run/my-daemon.pid"
log_dir='/var/log'
stdout_log="$log_dir/my-daemon.log"
stderr_log="$log_dir/my-daemon.err"

[ -r '/etc/my-daemon.env' ] && . '/etc/my-daemon.env'
export A_MODE='prod'
export B_TOKEN='it'\''s secret'

run_daemon() {
    exec '/usr/local/bin/my-daemon' 'run' '--config' '/etc/my daemon.yml' 'it'\''s'
}

get_pid() {
    [ -f "$pid_file" ] && cat "$pid_file"
}

is_running() {
    pid=$(get_pid)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
    if is_running; then
        echo "$name is already running"
        return 0
    fi
    [ -d "$log_dir" ] || mkdir -p "$log_dir" 2>/dev/null
    echo "Starting $name"
    run_daemon >>"$stdout_log" 2>>"$stderr_log" &
    echo $! >"$pid_file"
    return 0
}

stop() {
    if ! is_running; then
        echo "$name is not running"
        rm -f "$pid_file"
        return 0
    fi
    echo "Stopping $name"
    pid=$(get_pid)
    kill "$pid" 2>/dev/null
    i=0
    while [ $i -lt 10 ]; do
        is_running || break
        sleep 1
        i=$((i + 1))
    done
    if is_running; then
        echo "$name did not stop, sending SIGKILL"
        kill -9 "$pid" 2>/dev/null
    fi
    rm -f "$pid_file"
    return 0
}

status() {
    if is_running; then
        echo "$name is running"
        return 0
    fi
    echo "$name is not running"
    return 1
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)  status ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 2
        ;;
esac

exit 0
