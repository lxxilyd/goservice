#!/bin/sh /etc/rc.common
#
# my-daemon - installed by goservice

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command '/usr/local/bin/my-daemon' 'run' '--config' '/etc/my daemon.yml' 'it'\''s'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_set_param env A_MODE='prod'
	procd_set_param env B_TOKEN='it'\''s secret'
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "my-daemon"
}
